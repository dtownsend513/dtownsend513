3408L9.2168 15.2305C9.36965 15.1046 9.55583 14.9207 9.90527 14.5713L14.8926 9.58301L11.666 6.35742L6.67871 11.3447ZM16.1963 5.05371C15.3054 4.16304 13.8616 4.16305 12.9707 5.05371L12.6074 5.41602L15.833 8.64258L16.1963 8.2793C17.0869 7.38845 17.0869 5.94456 16.1963 5.05371Z"></path><path d="M4.58301 1.7832C4.72589 1.7832 4.84877 1.88437 4.87695 2.02441C4.99384 2.60873 5.22432 3.11642 5.58398 3.50391C5.94115 3.88854 6.44253 4.172 7.13281 4.28711C7.27713 4.3114 7.38267 4.43665 7.38281 4.58301C7.38281 4.7295 7.27723 4.8546 7.13281 4.87891C6.44249 4.99401 5.94116 5.27746 5.58398 5.66211C5.26908 6.00126 5.05404 6.43267 4.92676 6.92676L4.87695 7.1416C4.84891 7.28183 4.72601 7.38281 4.58301 7.38281C4.44013 7.38267 4.31709 7.28173 4.28906 7.1416C4.17212 6.55728 3.94179 6.04956 3.58203 5.66211C3.22483 5.27757 2.72347 4.99395 2.0332 4.87891C1.88897 4.85446 1.7832 4.72938 1.7832 4.58301C1.78335 4.43673 1.88902 4.3115 2.0332 4.28711C2.72366 4.17203 3.22481 3.88861 3.58203 3.50391C3.94186 3.11638 4.17214 2.60888 4.28906 2.02441L4.30371 1.97363C4.34801 1.86052 4.45804 1.78333 4.58301 1.7832Z"></path></svg>Edit</button></span></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-bash"><span><span><span class="hljs-comment"># from your local folder</span></span><span>
git branch            </span><span><span class="hljs-comment"># shows current local branches</span></span><span>
git push -u origin main
</span></span></code></div></div></pre>
<p data-start="563" data-end="630">Then refresh the GitHub page until you see “main” in that selector.</p>
<hr data-start="632" data-end="635">
<h3 data-start="637" data-end="677">2. Re‑authorize Netlify’s GitHub App</h3>
<p data-start="679" data-end="771">Even if the branch exists, Netlify won’t list it if it doesn’t have permission on your repo:</p>
<ol data-start="773" data-end="1024">
<li data-start="773" data-end="870">
<p data-start="776" data-end="870">On GitHub, click your profile → <strong data-start="808" data-end="820">Settings</strong> → <strong data-start="823" data-end="839">Applications</strong> → <strong data-start="842" data-end="867">Authorized OAuth Apps</strong>.</p>
</li>
<li data-start="871" data-end="948">
<p data-start="874" data-end="948">Find <strong data-start="879" data-end="890">Netlify</strong> and click <strong data-start="901" data-end="914">Configure</strong> (or <strong data-start="919" data-end="944">Revoke &amp; Re‑authorize</strong>).</p>
</li>
<li data-start="949" data-end="1024">
<p data-start="952" data-end="1024">Make sure your repo <strong data-start="972" data-end="1001">dtownsend513/dtownsend513</strong> is checked for access.</p>
</li>
</ol>
<hr data-start="1026" data-end="1029">
<h3 data-start="1031" data-end="1076">3. Back in Netlify: Refresh the repo list</h3>
<ol data-start="1078" data-end="1268">
<li data-start="1078" data-end="1198">
<p data-start="1081" data-end="1198">In Netlify’s “Link repository” panel, click the <strong data-start="1129" data-end="1140">Refresh</strong> or <strong data-start="1144" data-end="1157">Reconnect</strong> button next to the GitHub repo picker.</p>
</li>
<li data-start="1199" data-end="1268">
<p data-start="1202" data-end="1268">Wait a few seconds—your repo (and its branches) should repopulate.</p>
</li>
</ol>
<hr data-start="1270" data-end="1273">
<h3 data-start="1275" data-end="1311">4. Manually type the branch name</h3>
<p data-start="1313" data-end="1389">If the dropdown still shows blank, click into <strong data-start="1359" data-end="1379">Branch to deploy</strong>, type in:</p>
<pre class="overflow-visible!" data-start="1391" data-end="1403"><div class="contain-inline-size rounded-2xl relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl">css</div><div class="sticky top-9"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Copy"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon-xs"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.78896 16.835 6.5 16.835H9.33301C10.0439 16.835 10.5374 16.8341 10.9209 16.8027C11.2965 16.772 11.508 16.7152 11.666 16.6348L11.793 16.5645C12.0804 16.3881 12.3148 16.1351 12.4688 15.833L12.5244 15.7031C12.5759 15.5594 12.6137 15.3698 12.6367 15.0879C12.6681 14.7044 12.668 14.211 12.668 13.5V10.667ZM13.998 12.665C14.4528 12.6634 14.8011 12.6602 15.0879 12.6367C15.4635 12.606 15.675 12.5492 15.833 12.4688L15.959 12.3975C16.2466 12.2211 16.4808 11.9682 16.