5.3408L9.2168 15.2305C9.36965 15.1046 9.55583 14.9207 9.90527 14.5713L14.8926 9.58301L11.666 6.35742L6.67871 11.3447ZM16.1963 5.05371C15.3054 4.16304 13.8616 4.16305 12.9707 5.05371L12.6074 5.41602L15.833 8.64258L16.1963 8.2793C17.0869 7.38845 17.0869 5.94456 16.1963 5.05371Z"></path><path d="M4.58301 1.7832C4.72589 1.7832 4.84877 1.88437 4.87695 2.02441C4.99384 2.60873 5.22432 3.11642 5.58398 3.50391C5.94115 3.88854 6.44253 4.172 7.13281 4.28711C7.27713 4.3114 7.38267 4.43665 7.38281 4.58301C7.38281 4.7295 7.27723 4.8546 7.13281 4.87891C6.44249 4.99401 5.94116 5.27746 5.58398 5.66211C5.26908 6.00126 5.05404 6.43267 4.92676 6.92676L4.87695 7.1416C4.84891 7.28183 4.72601 7.38281 4.58301 7.38281C4.44013 7.38267 4.31709 7.28173 4.28906 7.1416C4.17212 6.55728 3.94179 6.04956 3.58203 5.66211C3.22483 5.27757 2.72347 4.99395 2.0332 4.87891C1.88897 4.85446 1.7832 4.72938 1.7832 4.58301C1.78335 4.43673 1.88902 4.3115 2.0332 4.28711C2.72366 4.17203 3.22481 3.88861 3.58203 3.50391C3.94186 3.11638 4.17214 2.60888 4.28906 2.02441L4.30371 1.97363C4.34801 1.86052 4.45804 1.78333 4.58301 1.7832Z"></path></svg>Edit</button></span></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-js"><span><span><span class="hljs-comment">// Mobile nav toggle</span></span><span>
</span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">querySelector</span></span><span>(</span><span><span class="hljs-string">'.nav-toggle'</span></span><span>).</span><span><span class="hljs-title function_">addEventListener</span></span><span>(</span><span><span class="hljs-string">'click'</span></span><span>,</span><span><span class="hljs-function">()=&gt;</span></span><span>{
  </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">querySelector</span></span><span>(</span><span><span class="hljs-string">'.nav-links'</span></span><span>).</span><span><span class="hljs-property">classList</span></span><span>.</span><span><span class="hljs-title function_">toggle</span></span><span>(</span><span><span class="hljs-string">'active'</span></span><span>);
});

</span><span><span class="hljs-comment">// Cookie banner</span></span><span>
</span><span><span class="hljs-keyword">if</span></span><span>(!</span><span><span class="hljs-variable language_">localStorage</span></span><span>.</span><span><span class="hljs-title function_">getItem</span></span><span>(</span><span><span class="hljs-string">'cookiesAccepted'</span></span><span>)){
  </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">'cookie-banner'</span></span><span>).</span><span><span class="hljs-property">style</span></span><span>.</span><span><span class="hljs-property">display</span></span><span>=</span><span><span class="hljs-string">'block'</span></span><span>;
}
</span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">'accept-cookies'</span></span><span>).</span><span><span class="hljs-title function_">addEventListener</span></span><span>(</span><span><span class="hljs-string">'click'</span></span><span>,</span><span><span class="hljs-function">()=&gt;</span></span><span>{
  </span><span><span class="hljs-variable language_">localStorage</span></span><span>.</span><span><span class="hljs-title function_">setItem</span></span><span>(</span><span><span class="hljs-string">'cookiesAccepted'</span></span><span>,</span><span><span class="hljs-string">'yes'</span></span><span>);
  </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">'cookie-banner'</span></span><span>).</span><span><span class="hljs-property">style</span></span><span>.</span><span><span class="hljs-property">display</span></span><span>=</span><span><span class="hljs-string">'none'</span></span><span>;
});
</span></span></code></div></div></pre>
<hr data-start="10593" data-end="10596">
<h2 data-start="10598" data-end="10624">6. Deploying to Netlify</h2>
<ol data-start="10626" data-end="10909">
<li data-start="10626" data-end="10680">
<p data-start="10629" data-end="10680"><strong data-start="10629" data-end="10637">Push</strong> your repo to GitHub (see earlier steps).</p>
</li>
<li data-start="10681" data-end="10745">
<p data-start="10684" data-end="10745"><strong data-start="10684" data-end="10695">Connect</strong> in Netlify (“New site from Git” → select repo).</p>
</li>
<li data-start="10746" data-end="10844">
<p data-start="10749" data-end="10770"><strong data-start="10749" data-end="10768">Build settings:</strong></p>
<ul data-start="10774" data-end="10844">
<li data-start="10774" data-end="10810">
<p data-start="10776" data-end="10810"><strong data-start="10776" data-end="10794">Build command:</strong> <em data-start="10795" data-end="10808">leave blank</em></p>
</li>
<li data-start="10814" data-end="10844">
<p data-start="10816" data-end="10844"><strong data-start="10816" data-end="10838">Publish directory:</strong> <code data-start="10839" data-end="10842">.</code></p>
</li>
</ul>
</li>
<li data-start="10845" data-end="10909">
<p data-start="10848" data-end="10909"><strong data-start="10848" data-end="10858">Deploy</strong>. Netlify will auto‑deploy on every push to <code data-start="10902" data-end="10908">main</code>.</p>
</li>
</ol>
<hr data-start="10911" data-end="10914">
<h2 data-start="10916" data-end="10940">7. Updating Your Site</h2>
<ul data-start="10942" data-end="11301">
<li data-start="10942" data-end="11017">
<p data-start="10944" data-end="11017"><strong data-start="10944" data-end="10952">Text</strong>: edit the <code data-start="10963" data-end="10969">&lt;h1&gt;</code>, <code data-start="10971" data-end="10976">&lt;p&gt;</code>, <code data-start="10978" data-end="10984">&lt;li&gt;</code> etc. directly in <code data-start="11002" data-end="11014">index.html</code>.</p>
</li>
<li data-start="11018" data-end="11095">
<p data-start="11020" data-end="11095"><strong data-start="11020" data-end="11039">Portfolio items</strong>: duplicate/remove <code data-start="11058" data-end="11066">.slide</code> blocks under <code data-start="11080" data-end="11092">#portfolio</code>.</p>
</li>
<li data-start="11096" data-end="11170">
<p data-start="11098" data-end="11170"><strong data-start="11098" data-end="11116">Hosting prices</strong>: change the <code data-start="11129" data-end="11144">&lt;p&gt;$50/mo&lt;/p&gt;</code> etc. in the plans grid.</p>
</li>
<li data-start="11171" data-end="11240">
<p data-start="11173" data-end="11240"><strong data-start="11173" data-end="11189">Images/icons</strong>: swap files in <code data-start="11205" data-end="11214">assets/</code> and update <code data-start="11226" data-end="11231">src</code> paths.</p>
</li>
<li data-start="11241" data-end="11301">
<p data-start="11243" data-end="11301"><strong data-start="11243" data-end="11252">Fonts</strong>: tweak the Google‑Fonts link or CSS <code data-start="11289" data-end="11298">@import</code>.</p>
</li>
</ul>
<p data-start="11303" data-end="11401">With this you have a complete, static Netlify‑hosted site—just clone, paste these files, and push!</p>
</div></div></div></div><div class="flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-selected="false" data-testid="copy-turn-action-button" data-state="closed"><span class="touch:w-10 flex h-8 w-8 items-center justify-center"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.78896 16.835 6.5 16.835H9.33301C10.043