  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
}
</span><span><span class="hljs-selector-class">.hero-section</span></span><span> </span><span><span class="hljs-selector-tag">h1</span></span><span> {
  </span><span><span class="hljs-attribute">font-family</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--font-heading);
  </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">3rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">0.5em</span></span><span>;
}
</span><span><span class="hljs-selector-class">.hero-section</span></span><span> </span><span><span class="hljs-selector-tag">p</span></span><span> {
  </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">1.125rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">1em</span></span><span>;
}
</span><span><span class="hljs-selector-class">.btn-primary</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: inline-block;
  </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--color-accent);
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0.75em</span></span><span> </span><span><span class="hljs-number">1.5em</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">4px</span></span><span>;
  </span><span><span class="hljs-attribute">font-weight</span></span><span>: bold;
}
</span><span><span class="hljs-selector-class">.btn-primary</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
  </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#e55a00</span></span><span>; </span><span><span class="hljs-comment">/* slightly darker */</span></span><span>
}
</span></span></code></div></div></pre>
