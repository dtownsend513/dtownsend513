  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Ready to Get Started?</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">form</span></span></span><span> </span><span><span class="hljs-attr">name</span></span><span>=</span><span><span class="hljs-string">"contact"</span></span><span> </span><span><span class="hljs-attr">method</span></span><span>=</span><span><span class="hljs-string">"POST"</span></span><span> </span><span><span class="hljs-attr">data-netlify</span></span><span>=</span><span><span class="hljs-string">"true"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"hidden"</span></span><span> </span><span><span class="hljs-attr">name</span></span><span>=</span><span><span class="hljs-string">"form-name"</span></span><span> </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">"contact"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Name</span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"text"</span></span><span> </span><span><span class="hljs-attr">name</span></span><span>=</span><span><span class="hljs-string">"name"</span></span><span> </span><span><span class="hljs-attr">required</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Email</span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"email"</span></span><span> </span><span><span class="hljs-attr">name</span></span><span>=</span><span><span class="hljs-string">"email"</span></span><span> </span><span><span class="hljs-attr">required</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Phone</span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"tel"</span></span><span> </span><span><span class="hljs-attr">name</span></span><span>=</span><span><span class="hljs-string">"phone"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Project Details</span><span><span class="hljs-tag">&lt;<span class="hljs-name">textarea</span></span></span><span> </span><span><span class="hljs-attr">name</span></span><span>=</span><span><span class="hljs-string">"message"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">textarea</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"checkbox"</span></span><span> </span><span><span class="hljs-attr">name</span></span><span>=</span><span><span class="hljs-string">"newsletter"</span></span><span>&gt; Subscribe to newsletter</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"submit"</span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"btn btn-primary"</span></span><span>&gt;Send Message</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">form</span></span></span><span>&gt;
  </span><span><span class="hljs-comment">&lt;!-- Calendly embed --&gt;</span></span><span>
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"calendly-inline-widget"</span></span><span> </span><span><span class="hljs-attr">data-url</span></span><span>=</span><span><span class="hljs-string">"https://calendly.com/your-calendly/30min"</span></span><span> </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">"min-width:320px;height:630px;"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">script</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">"https://assets.calendly.com/assets/external/widget.js"</span></span><span> </span><span><span class="hljs-attr">async</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;
</span></span></code></div></div></pre>
