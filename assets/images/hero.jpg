  </span><span><span class="hljs-attr">--clr-accent</span></span><span>: </span><span><span class="hljs-number">#FF6B00</span></span><span>;
  </span><span><span class="hljs-attr">--clr-dark</span></span><span>: </span><span><span class="hljs-number">#333</span></span><span>;
  </span><span><span class="hljs-attr">--clr-light</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attr">--ff-heading</span></span><span>: </span><span><span class="hljs-string">'Inter'</span></span><span>, sans-serif;
  </span><span><span class="hljs-attr">--ff-body</span></span><span>: </span><span><span class="hljs-string">'Inter'</span></span><span>, sans-serif;
}
*{</span><span><span class="hljs-attribute">margin</span></span><span>:</span><span><span class="hljs-number">0</span></span><span>;</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">0</span></span><span>;</span><span><span class="hljs-attribute">box-sizing</span></span><span>:border-box;}
</span><span><span class="hljs-selector-tag">body</span></span><span>{</span><span><span class="hljs-attribute">font-family</span></span><span>:</span><span><span class="hljs-built_in">var</span></span><span>(--ff-body);</span><span><span class="hljs-attribute">color</span></span><span>:</span><span><span class="hljs-built_in">var</span></span><span>(--clr-dark);</span><span><span class="hljs-attribute">line-height</span></span><span>:</span><span><span class="hljs-number">1.6</span></span><span>;}
</span><span><span class="hljs-selector-class">.navbar</span></span><span>{</span><span><span class="hljs-attribute">position</span></span><span>:fixed;</span><span><span class="hljs-attribute">top</span></span><span>:</span><span><span class="hljs-number">0</span></span><span>;</span><span><span class="hljs-attribute">width</span></span><span>:</span><span><span class="hljs-number">100%</span></span><span>;</span><span><span class="hljs-attribute">display</span></span><span>:flex;</span><span><span class="hljs-attribute">align-items</span></span><span>:center;</span><span><span class="hljs-attribute">justify-content</span></span><span>:space-between;</span><span><span class="hljs-attribute">background</span></span><span>:</span><span><span class="hljs-number">#fff</span></span><span>;</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;</span><span><span class="hljs-attribute">box-shadow</span></span><span>:</span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">2px</span></span><span> </span><span><span class="hljs-number">6px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,.</span><span><span class="hljs-number">1</span></span><span>);</span><span><span class="hljs-attribute">z-index</span></span><span>:</span><span><span class="hljs-number">100</span></span><span>;}
</span><span><span class="hljs-selector-class">.logo</span></span><span>{</span><span><span class="hljs-attribute">height</span></span><span>:</span><span><span class="hljs-number">40px</span></span><span>;}
</span><span><span class="hljs-selector-class">.nav-links</span></span><span>{</span><span><span class="hljs-attribute">list-style</span></span><span>:none;</span><span><span class="hljs-attribute">display</span></span><span>:flex;</span><span><span class="hljs-attribute">gap</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;}
</span><span><span class="hljs-selector-class">.nav-links</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span>{</span><span><span class="hljs-attribute">color</span></span><span>:</span><span><span class="hljs-built_in">var</span></span><span>(--clr-dark);</span><span><span class="hljs-attribute">text-decoration</span></span><span>:none;</span><span><span class="hljs-attribute">font-weight</span></span><span>:</span><span><span class="hljs-number">600</span></span><span>;}
</span><span><span class="hljs-selector-class">.nav-toggle</span></span><span>{</span><span><span class="hljs-attribute">display</span></span><span>:none;}
</span><span><span class="hljs-selector-class">.btn</span></span><span>{</span><span><span class="hljs-attribute">font-family</span></span><span>:</span><span><span class="hljs-built_in">var</span></span><span>(--ff-heading);</span><span><span class="hljs-attribute">padding</span></span><span>:.</span><span><span class="hljs-number">75em</span></span><span> </span><span><span class="hljs-number">1.25em</span></span><span>;</span><span><span class="hljs-attribute">border</span></span><span>:none;</span><span><span class="hljs-attribute">border-radius</span></span><span>:</span><span><span class="hljs-number">4px</span></span><span>;</span><span><span class="hljs-attribute">cursor</span></span><span>:pointer;}
</span><span><span class="hljs-selector-class">.btn-primary</span></span><span>{</span><span><span class="hljs-attribute">background</span></span><span>:</span><span><span class="hljs-built_in">var</span></span><span>(--clr-accent);</span><span><span class="hljs-attribute">color</span></span><span>:</span><span><span class="hljs-number">#fff</span></span><span>;}
</span><span><span class="hljs-selector-class">.hero</span></span><span>{</span><span><span class="hljs-attribute">background</span></span><span>:</span><span><span class="hljs-built_in">url</span></span><span>(</span><span><span class="hljs-string">'assets/hero.jpg'</span></span><span>)center/cover no-repeat;</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">10rem</span></span><span> </span><span><span class="hljs-number">1rem</span></span><span>;</span><span><span class="hljs-attribute">text-align</span></span><span>:center;</span><span><span class="hljs-attribute">color</span></span><span>:</span><span><span class="hljs-number">#fff</span></span><span>;}
</span><span><span class="hljs-selector-class">.hero-content</span></span><span> </span><span><span class="hljs-selector-tag">h1</span></span><span>{</span><span><span class="hljs-attribute">font-family</span></span><span>:</span><span><span class="hljs-built_in">var</span></span><span>(--ff-heading);</span><span><span class="hljs-attribute">font-size</span></span><span>:</span><span><span class="hljs-number">3rem</span></span><span>;</span><span><span class="hljs-attribute">max-width</span></span><span>:</span><span><span class="hljs-number">800px</span></span><span>;</span><span><span class="hljs-attribute">margin</span></span><span>:</span><span><span class="hljs-number">0</span></span><span> auto;}
</span><span><span class="hljs-selector-class">.services</span></span><span>, </span><span><span class="hljs-selector-class">.portfolio</span></span><span>, </span><span><span class="hljs-selector-class">.plans</span></span><span>, </span><span><span class="hljs-selector-class">.about</span></span><span>, </span><span><span class="hljs-selector-class">.process</span></span><span>, </span><span><span class="hljs-selector-class">.testimonials</span></span><span>, </span><span><span class="hljs-selector-class">.contact</span></span><span>{</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">6rem</span></span><span> </span><span><span class="hljs-number">1rem</span></span><span>;</span><span><span class="hljs-attribute">text-align</span></span><span>:center;}
</span><span><span class="hljs-selector-class">.services-grid</span></span><span>, </span><span><span class="hljs-selector-class">.plans-grid</span></span><span>, </span><span><span class="hljs-selector-class">.about-grid</span></span><span>, </span><span><span class="hljs-selector-class">.process-grid</span></span><span>{</span><span><span class="hljs-attribute">display</span></span><span>:grid;</span><span><span class="hljs-attribute">gap</span></span><span>:</span><span><span class="hljs-number">2rem</span></span><span>;}
</span><span><span class="hljs-selector-class">.services-grid</span></span><span>{</span><span><span class="hljs-attribute">grid-template-columns</span></span><span>:</span><span><span class="hljs-built_in">repeat</span></span><span>(auto-fit,</span><span><span class="hljs-built_in">minmax</span></span><span>(</span><span><span class="hljs-number">240px</span></span><span>,</span><span><span class="hljs-number">1</span></span><span>fr));}
</span><span><span class="hljs-selector-class">.plans-grid</span></span><span>{</span><span><span class="hljs-attribute">grid-template-columns</span></span><span>:</span><span><span class="hljs-built_in">repeat</span></span><span>(auto-fit,</span><span><span class="hljs-built_in">minmax</span></span><span>(</span><span><span class="hljs-number">200px</span></span><span>,</span><span><span class="hljs-number">1</span></span><span>fr));}
</span><span><span class="hljs-selector-class">.about-grid</span></span><span>{</span><span><span class="hljs-attribute">grid-template-columns</span></span><span>:</span><span><span class="hljs-number">1</span></span><span>fr </span><span><span class="hljs-number">1</span></span><span>fr;</span><span><span class="hljs-attribute">align-items</span></span><span>:center;}
</span><span><span class="hljs-selector-class">.process-grid</span></span><span>{</span><span><span class="hljs-attribute">grid-template-columns</span></span><span>:</span><span><span class="hljs-built_in">repeat</span></span><span>(auto-fit,</span><span><span class="hljs-built_in">minmax</span></span><span>(</span><span><span class="hljs-number">150px</span></span><span>,</span><span><span class="hljs-number">1</span></span><span>fr));}
</span><span><span class="hljs-selector-class">.carousel</span></span><span>{</span><span><span class="hljs-attribute">display</span></span><span>:flex;</span><span><span class="hljs-attribute">overflow-x</span></span><span>:auto;</span><span><span class="hljs-attribute">gap</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;}
</span><span><span class="hljs-selector-class">.slide</span></span><span>{</span><span><span class="hljs-attribute">position</span></span><span>:relative;</span><span><span class="hljs-attribute">flex</span></span><span>:</span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">80%</span></span><span>;</span><span><span class="hljs-attribute">max-width</span></span><span>:</span><span><span class="hljs-number">400px</span></span><span>;}
</span><span><span class="hljs-selector-class">.slide</span></span><span> </span><span><span class="hljs-selector-tag">img</span></span><span>{</span><span><span class="hljs-attribute">width</span></span><span>:</span><span><span class="hljs-number">100%</span></span><span>;</span><span><span class="hljs-attribute">border-radius</span></span><span>:</span><span><span class="hljs-number">8px</span></span><span>;}
</span><span><span class="hljs-selector-class">.overlay</span></span><span>{</span><span><span class="hljs-attribute">position</span></span><span>:absolute;</span><span><span class="hljs-attribute">bottom</span></span><span>:</span><span><span class="hljs-number">0</span></span><span>;</span><span><span class="hljs-attribute">left</span></span><span>:</span><span><span class="hljs-number">0</span></span><span>;</span><span><span class="hljs-attribute">width</span></span><span>:</span><span><span class="hljs-number">100%</span></span><span>;</span><span><span class="hljs-attribute">background</span></span><span>:</span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,.</span><span><span class="hljs-number">6</span></span><span>);</span><span><span class="hljs-attribute">color</span></span><span>:</span><span><span class="hljs-number">#fff</span></span><span>;</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;</span><span><span class="hljs-attribute">text-align</span></span><span><span class="hljs-selector-pseudo">:left</span></span><span>;</span><span><span class="hljs-attribute">border-radius</span></span><span>:</span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">8px</span></span><span> </span><span><span class="hljs-number">8px</span></span><span>;}
</span><span><span class="hljs-selector-class">.testimonials-slider</span></span><span>{</span><span><span class="hljs-attribute">display</span></span><span>:flex;</span><span><span class="hljs-attribute">overflow-x</span></span><span>:auto;</span><span><span class="hljs-attribute">gap</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;}
</span><span><span class="hljs-selector-class">.testimonial</span></span><span>{</span><span><span class="hljs-attribute">flex</span></span><span>:</span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">80%</span></span><span>;</span><span><span class="hljs-attribute">max-width</span></span><span>:</span><span><span class="hljs-number">300px</span></span><span>;</span><span><span class="hljs-attribute">border</span></span><span>:</span><span><span class="hljs-number">1px</span></span><span> solid </span><span><span class="hljs-number">#eee</span></span><span>;</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;</span><span><span class="hljs-attribute">border-radius</span></span><span>:</span><span><span class="hljs-number">8px</span></span><span>;</span><span><span class="hljs-attribute">text-align</span></span><span><span class="hljs-selector-pseudo">:left</span></span><span>;}
</span><span><span class="hljs-selector-class">.cookie-banner</span></span><span>{</span><span><span class="hljs-attribute">position</span></span><span>:fixed;</span><span><span class="hljs-attribute">bottom</span></span><span>:</span><span><span class="hljs-number">0</span></span><span>;</span><span><span class="hljs-attribute">width</span></span><span>:</span><span><span class="hljs-number">100%</span></span><span>;</span><span><span class="hljs-attribute">background</span></span><span>:</span><span><span class="hljs-number">#333</span></span><span>;</span><span><span class="hljs-attribute">color</span></span><span>:</span><span><span class="hljs-number">#fff</span></span><span>;</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;</span><span><span class="hljs-attribute">text-align</span></span><span>:center;}
</span><span><span class="hljs-selector-class">.cookie-banner</span></span><span> </span><span><span class="hljs-selector-tag">button</span></span><span>{</span><span><span class="hljs-attribute">margin-left</span></span><span>:</span><span><span class="hljs-number">1rem</span></span><span>;</span><span><span class="hljs-attribute">padding</span></span><span>:.</span><span><span class="hljs-number">5em</span></span><span> </span><span><span class="hljs-number">1em</span></span><span>;</span><span><span class="hljs-attribute">border</span></span><span>:none;</span><span><span class="hljs-attribute">border-radius</span></span><span>:</span><span><span class="hljs-number">4px</span></span><span>;</span><span><span class="hljs-attribute">background</span></span><span>:</span><span><span class="hljs-built_in">var</span></span><span>(--clr-accent);</span><span><span class="hljs-attribute">color</span></span><span>:</span><span><span class="hljs-number">#fff</span></span><span>;}
</span><span><span class="hljs-selector-class">.footer</span></span><span>{</span><span><span class="hljs-attribute">background</span></span><span>:</span><span><span class="hljs-number">#f9f9f9</span></span><span>;</span><span><span class="hljs-attribute">padding</span></span><span>:</span><span><span class="hljs-number">2rem</span></span><span>;</span><span><span class="hljs-attribute">text-align</span></span><span>:center;}
</span><span><span class="hljs-keyword">@media</span></span><span>(max-width:768px){
  </span><span><span class="hljs-selector-class">.about-grid</span></span><span>{</span><span><span class="hljs-attribute">grid-template-columns</span></span><span>:</span><span><span class="hljs-number">1</span></span><span>fr;}
  </span><span><span class="hljs-selector-class">.nav-links</span></span><span>{</span><span><span class="hljs-attribute">display</span></span><span>:none;}
  </span><span><span class="hljs-selector-class">.nav-toggle</span></span><span>{</span><span><span class="hljs-attribute">display</span></span><span>:block;}
}
</span></span></code></div></div></pre>
