  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"container header-inner"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"/"</span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"logo-link"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">"https://your-cdn.com/ttlogo.png"</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"Townsend &amp; Townsend Logo"</span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"logo-img"</span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">nav</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"main-nav"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"#services"</span></span><span>&gt;Services</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"#portfolio"</span></span><span>&gt;Portfolio</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"#about"</span></span><span>&gt;About</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"#contact"</span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"btn btn-nav"</span></span><span>&gt;Get a Quote</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">nav</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">header</span></span></span><span>&gt;
</span></span></code></div></div></pre>
