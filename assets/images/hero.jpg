<h2 data-start="4737" data-end="4767">4. Rollout &amp; Migration Plan</h2>
<div class="_tableContainer_16hzy_1"><div tabindex="-1" class="_tableWrapper_16hzy_14 group flex w-fit flex-col-reverse"><table data-start="4769" data-end="5948" class="w-fit min-w-(--thread-content-width)"><thead data-start="4769" data-end="4886"><tr data-start="4769" data-end="4886"><th data-start="4769" data-end="4793" data-col-size="sm">Phase</th><th data-start="4793" data-end="4859" data-col-size="md">Tasks</th><th data-start="4859" data-end="4872" data-col-size="sm">Owner</th><th data-start="4872" data-end="4886" data-col-size="sm">ETA</th></tr></thead><tbody data-start="5005" data-end="5948"><tr data-start="5005" data-end="5122"><td data-start="5005" data-end="5029" data-col-size="sm"><strong data-start="5007" data-end="5028">Kick‑off &amp; Assets</strong></td><td data-start="5029" data-end="5095" data-col-size="md">Gather logos, brand‑kit, hero image, client testimonials</td><td data-start="5095" data-end="5108" data-col-size="sm">You</td><td data-start="5108" data-end="5122" data-col-size="sm">Day 0–1</td></tr><tr data-start="5123" data-end="5240"><td data-start="5123" data-end="5147" data-col-size="sm"><strong data-start="5125" data-end="5143">Design (Figma)</strong></td><td data-start="5147" data-end="5213" data-col-size="md">Wireframe → high‑fidelity mockup → review &amp; approvals</td><td data-start="5213" data-end="5226" data-col-size="sm">Designer</td><td data-start="5226" data-end="5240" data-col-size="sm">Day 1–3</td></tr><tr data-start="5241" data-end="5358"><td data-start="5241" data-end="5265" data-col-size="sm"><strong data-start="5243" data-end="5261">HTML/CSS Build</strong></td><td data-start="5265" data-end="5331" data-col-size="md">Develop sections in SiteSwan custom blocks; integrate assets</td><td data-start="5331" data-end="5344" data-col-size="sm">Dev Team</td><td data-start="5344" data-end="5358" data-col-size="sm">Day 4–8</td></tr><tr data-start="5359" data-end="5476"><td data-start="5359" data-end="5383" data-col-size="sm"><strong data-start="5361" data-end="5378">Content &amp; SEO</strong></td><td data-start="5383" data-end="5449" data-col-size="md">Add copy, meta tags, alt text, Open Graph tags</td><td data-start="5449" data-end="5462" data-col-size="sm">Content</td><td data-start="5462" data-end="5476" data-col-size="sm">Day 9–10</td></tr><tr data-start="5477" data-end="5594"><td data-start="5477" data-end="5501" data-col-size="sm"><strong data-start="5479" data-end="5495">QA &amp; Testing</strong></td><td data-start="5501" data-end="5567" data-col-size="md">Cross‑browser, mobile, accessibility, performance (Lighthouse)</td><td data-start="5567" data-end="5580" data-col-size="sm">QA</td><td data-start="5580" data-end="5594" data-col-size="sm">Day 11–12</td></tr><tr data-start="5595" data-end="5712"><td data-start="5595" data-end="5619" data-col-size="sm"><strong data-start="5597" data-end="5615">Staging Review</strong></td><td data-start="5619" data-end="5685" data-col-size="md">Client walkthrough, gather feedback</td><td data-start="5685" data-end="5698" data-col-size="sm">You/Client</td><td data-start="5698" data-end="5712" data-col-size="sm">Day 13</td></tr><tr data-start="5713" data-end="5830"><td data-start="5713" data-end="5737" data-col-size="sm"><strong data-start="5715" data-end="5732">Optimizations</strong></td><td data-start="5737" data-end="5803" data-col-size="md">Address feedback, optimize images (WebP), minify CSS/JS</td><td data-start="5803" data-end="5816" data-col-size="sm">Dev Team</td><td data-start="5816" data-end="5830" data-col-size="sm">Day 14</td></tr><tr data-start="5831" data-end="5948"><td data-start="5831" data-end="5855" data-col-size="sm"><strong data-start="5833" data-end="5844">Go‑Live</strong></td><td data-start="5855" data-end="5921" data-col-size="md">DNS switch, final smoke test, post‑launch monitoring</td><td data-start="5921" data-end="5934" data-col-size="sm">Ops</td><td data-start="5934" data-end="5948" data-col-size="sm">Day 15</td></tr></tbody></tabl