5.3408L9.2168 15.2305C9.36965 15.1046 9.55583 14.9207 9.90527 14.5713L14.8926 9.58301L11.666 6.35742L6.67871 11.3447ZM16.1963 5.05371C15.3054 4.16304 13.8616 4.16305 12.9707 5.05371L12.6074 5.41602L15.833 8.64258L16.1963 8.2793C17.0869 7.38845 17.0869 5.94456 16.1963 5.05371Z"></path><path d="M4.58301 1.7832C4.72589 1.7832 4.84877 1.88437 4.87695 2.02441C4.99384 2.60873 5.22432 3.11642 5.58398 3.50391C5.94115 3.88854 6.44253 4.172 7.13281 4.28711C7.27713 4.3114 7.38267 4.43665 7.38281 4.58301C7.38281 4.7295 7.27723 4.8546 7.13281 4.87891C6.44249 4.99401 5.94116 5.27746 5.58398 5.66211C5.26908 6.00126 5.05404 6.43267 4.92676 6.92676L4.87695 7.1416C4.84891 7.28183 4.72601 7.38281 4.58301 7.38281C4.44013 7.38267 4.31709 7.28173 4.28906 7.1416C4.17212 6.55728 3.94179 6.04956 3.58203 5.66211C3.22483 5.27757 2.72347 4.99395 2.0332 4.87891C1.88897 4.85446 1.7832 4.72938 1.7832 4.58301C1.78335 4.43673 1.88902 4.3115 2.0332 4.28711C2.72366 4.17203 3.22481 3.88861 3.58203 3.50391C3.94186 3.11638 4.17214 2.60888 4.28906 2.02441L4.30371 1.97363C4.34801 1.86052 4.45804 1.78333 4.58301 1.7832Z"></path></svg>Edit</button></span></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-css"><span><span><span class="hljs-comment">/* 1. Variables &amp; Reset */</span></span><span>
</span><span><span class="hljs-selector-pseudo">:root</span></span><span> {
  </span><span><span class="hljs-attr">--color-gold</span></span><span>: </span><span><span class="hljs-number">#C59D5F</span></span><span>;
  </span><span><span class="hljs-attr">--gradient-gold</span></span><span>: </span><span><span class="hljs-built_in">linear-gradient</span></span><span>(</span><span><span class="hljs-number">90deg</span></span><span>, </span><span><span class="hljs-number">#E6C56A</span></span><span> </span><span><span class="hljs-number">0%</span></span><span>, </span><span><span class="hljs-number">#C59D5F</span></span><span> </span><span><span class="hljs-number">50%</span></span><span>, </span><span><span class="hljs-number">#8F6A3F</span></span><span> </span><span><span class="hljs-number">100%</span></span><span>);
  </span><span><span class="hljs-attr">--color-dark</span></span><span>:  </span><span><span class="hljs-number">#333333</span></span><span>;
  </span><span><span class="hljs-attr">--font-heading</span></span><span>: </span><span><span class="hljs-string">'Montserrat'</span></span><span>, sans-serif;
  </span><span><span class="hljs-attr">--font-body</span></span><span>:    </span><span><span class="hljs-string">'Open Sans'</span></span><span>, sans-serif;
}

*,
*</span><span><span class="hljs-selector-pseudo">::before</span></span><span>,
*</span><span><span class="hljs-selector-pseudo">::after</span></span><span> {
  </span><span><span class="hljs-attribute">box-sizing</span></span><span>: border-box;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
}

</span><span><span class="hljs-selector-tag">body</span></span><span> {
  </span><span><span class="hljs-attribute">font-family</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--font-body);
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--color-dark);
  </span><span><span class="hljs-attribute">line-height</span></span><span>: </span><span><span class="hljs-number">1.6</span></span><span>;
}

</span><span><span class="hljs-selector-tag">img</span></span><span> {
  </span><span><span class="hljs-attribute">max-width</span></span><span>: </span><span><span class="hljs-number">100%</span></span><span>;
  </span><span><span class="hljs-attribute">display</span></span><span>: block;
}

</span><span><span class="hljs-selector-tag">a</span></span><span> {
  </span><span><span class="hljs-attribute">text-decoration</span></span><span>: none;
  </span><span><span class="hljs-attribute">color</span></span><span>: inherit;
}

</span><span><span class="hljs-selector-class">.container</span></span><span> {
  </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">90%</span></span><span>;
  </span><span><span class="hljs-attribute">max-width</span></span><span>: </span><span><span class="hljs-number">1200px</span></span><span>;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> auto;
}

</span><span><span class="hljs-comment">/* 2. Header */</span></span><span>
</span><span><span class="hljs-selector-class">.site-header</span></span><span> {
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">1rem</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">position</span></span><span>: sticky;
  </span><span><span class="hljs-attribute">top</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">2px</span></span><span> </span><span><span class="hljs-number">6px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0.05</span></span><span>);
  </span><span><span class="hljs-attribute">z-index</span></span><span>: </span><span><span class="hljs-number">100</span></span><span>;
}
</span><span><span class="hljs-selector-class">.header-inner</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: flex;
  </span><span><span class="hljs-attribute">align-items</span></span><span>: center;
  </span><span><span class="hljs-attribute">justify-content</span></span><span>: space-between;
}
</span><span><span class="hljs-selector-class">.logo-img</span></span><span> { </span><span><span class="hljs-attribute">height</span></span><span>: </span><span><span class="hljs-number">60px</span></span><span>; }
</span><span><span class="hljs-selector-class">.main-nav</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span> { </span><span><span class="hljs-attribute">margin-left</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span>; </span><span><span class="hljs-attribute">font-weight</span></span><span>: </span><span><span class="hljs-number">600</span></span><span>; }
</span><span><span class="hljs-selector-class">.btn-nav</span></span><span> {
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--gradient-gold);
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0.5em</span></span><span> </span><span><span class="hljs-number">1em</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">4px</span></span><span>;
}
</span><span><span class="hljs-selector-class">.btn-nav</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span> { </span><span><span class="hljs-attribute">filter</span></span><span>: </span><span><span class="hljs-built_in">brightness</span></span><span>(</span><span><span class="hljs-number">1.1</span></span><span>); }

</span><span><span class="hljs-comment">/* 3. Hero */</span></span><span>
</span><span><span class="hljs-selector-class">.hero-section</span></span><span> {
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">url</span></span><span>(</span><span><span class="hljs-string">'assets/hero-bg.webp'</span></span><span>) center/cover no-repeat;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">120px</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
}
</span><span><span class="hljs-selector-class">.hero-section</span></span><span> </span><span><span class="hljs-selector-tag">h1</span></span><span> {
  </span><span><span class="hljs-attribute">font-family</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--font-heading);
  </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">3rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">0.5em</span></span><span>;
}
</span><span><span class="hljs-selector-class">.hero-section</span></span><span> </span><span><span class="hljs-selector-tag">p</span></span><span> { </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">1.125rem</span></span><span>; </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">1em</span></span><span>; }
</span><span><span class="hljs-selector-class">.btn-primary</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: inline-block;
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--gradient-gold);
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0.75em</span></span><span> </span><span><span class="hljs-number">1.5em</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">4px</span></span><span>;
  </span><span><span class="hljs-attribute">font-weight</span></span><span>: bold;
}
</span><span><span class="hljs-selector-class">.btn-primary</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span> { </span><span><span class="hljs-attribute">filter</span></span><span>: </span><span><span class="hljs-built_in">brightness</span></span><span>(</span><span><span class="hljs-number">1.1</span></span><span>); }

</span><span><span class="hljs-comment">/* 4. Services */</span></span><span>
</span><span><span class="hljs-selector-class">.services-grid</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: grid;
  </span><span><span class="hljs-attribute">grid-template-columns</span></span><span>: </span><span><span class="hljs-built_in">repeat</span></span><span>(auto-fit,</span><span><span class="hljs-built_in">minmax</span></span><span>(</span><span><span class="hljs-number">240px</span></span><span>,</span><span><span class="hljs-number">1</span></span><span>fr));
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">2rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">80px</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
}
</span><span><span class="hljs-selector-class">.service-card</span></span><span> </span><span><span class="hljs-selector-tag">h3</span></span><span> {
  </span><span><span class="hljs-attribute">font-family</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--font-heading);
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0.5em</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
}
</span><span><span class="hljs-selector-class">.service-card</span></span><span> </span><span><span class="hljs-selector-tag">p</span></span><span> { </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#555</span></span><span>; }

</span><span><span class="hljs-comment">/* 5. Portfolio */</span></span><span>
</span><span><span class="hljs-selector-class">.portfolio-grid</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: grid;
  </span><span><span class="hljs-attribute">grid-template-columns</span></span><span>: </span><span><span class="hljs-built_in">repeat</span></span><span>(auto-fit,</span><span><span class="hljs-built_in">minmax</span></span><span>(</span><span><span class="hljs-number">280px</span></span><span>,</span><span><span class="hljs-number">1</span></span><span>fr));
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span>;
}
</span><span><span class="hljs-selector-class">.portfolio-item</span></span><span> </span><span><span class="hljs-selector-tag">h4</span></span><span> {
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
  </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">0.5em</span></span><span>;
  </span><span><span class="hljs-attribute">font-family</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--font-heading);
}

</span><span><span class="hljs-comment">/* 6. About */</span></span><span>
</span><span><span class="hljs-selector-class">.about-section</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: flex;
  </span><span><span class="hljs-attribute">flex-wrap</span></span><span>: wrap;
  </span><span><span class="hljs-attribute">align-items</span></span><span>: center;
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">2rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">80px</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
}
</span><span><span class="hljs-selector-class">.about-text</span></span><span> { </span><span><span class="hljs-attribute">flex</span></span><span>: </span><span><span class="hljs-number">1</span></span><span>; }
</span><span><span class="hljs-selector-class">.about-image</span></span><span> </span><span><span class="hljs-selector-tag">img</span></span><span> { </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>; }

</span><span><span class="hljs-comment">/* 7. Process */</span></span><span>
</span><span><span class="hljs-selector-class">.process-grid</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: grid;
  </span><span><span class="hljs-attribute">grid-template-columns</span></span><span>: </span><span><span class="hljs-built_in">repeat</span></span><span>(auto-fit,</span><span><span class="hljs-built_in">minmax</span></span><span>(</span><span><span class="hljs-number">200px</span></span><span>,</span><span><span class="hljs-number">1</span></span><span>fr));
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">2rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span>;
}
</span><span><span class="hljs-selector-class">.process-step</span></span><span> </span><span><span class="hljs-selector-tag">span</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: inline-block;
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">var</span></span><span>(--color-gold);
  </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#fff</span></span><span>;
  </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">32px</span></span><span>;
  </span><span><span class="hljs-attribute">height</span></span><span>: </span><span><span class="hljs-number">32px</span></span><span>;
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
  </span><span><span class="hljs-attribute">line-height</span></span><span>: </span><span><span class="hljs-number">32px</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">50%</span></span><span>;
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">0.5em</span></span><span>;
}

</span><span><span class="hljs-comment">/* 8. Testimonials */</span></span><span>
</span><span><span class="hljs-selector-class">.testimonial-carousel</span></span><span> {
  </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span>;
}
</span><span><span class="hljs-selector-class">.testimonial</span></span><span> {
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span>;
  </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">1px</span></span><span> solid </span><span><span class="hljs-number">#eee</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">1rem</span></span><span>;
}

</span><span><span class="hljs-comment">/* 9. Pricing */</span></span><span>
</span><span><span class="hljs-selector-class">.pricing-grid</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: grid;
  </span><span><span class="hljs-attribute">grid-template-columns</span></span><span>: </span><span><span class="hljs-built_in">repeat</span></span><span>(auto-fit,</span><span><span class="hljs-built_in">minmax</span></span><span>(</span><span><span class="hljs-number">240px</span></span><span>,</span><span><span class="hljs-number">1</span></span><span>fr));
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
}
</span><span><span class="hljs-selector-class">.plan</span></span><span> {
  </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">1px</span></span><span> solid </span><span><span class="hljs-number">#ddd</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">1.5rem</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">8px</span></span><span>;
  </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
}

</span><span><span class="hljs-comment">/*  🔟 Contact */</span></span><span>
</span><span><span class="hljs-selector-class">.contact-form</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: grid;
  </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">1rem</span></span><span>;
  </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">2rem</span></span><span>;
}
</span><span><span class="hljs-selector-class">.contact-form</span></span><span> </span><span><span class="hljs-selector-tag">label</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: flex;
  </span><span><span class="hljs-attribute">flex-direction</span></span><span>: column;
  </span><span><span class="hljs-attribute">font-weight</span></span><span>: </span><span><span class="hljs-number">600</span></span><span>;
}
</span><span><span class="hljs-selector-class">.contact-form</span></span><span> </span><span><span class="hljs-selector-tag">input</span></span><span>,
</span><span><span class="hljs-selector-class">.contact-form</span></span><span> </span><span><span class="hljs-selector-tag">textarea</span></span><span> {
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0.5em</span></span><span>;
  </span><span><span class="hljs-attribute">border</span></span><span>: </span><span><span class="hljs-number">1px</span></span><span> solid </span><span><span class="hljs-number">#ccc</span></span><span>;
  </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">4px</span></span><span>;
}

</span><span><span class="hljs-comment">/* 🔷 Footer */</span></span><span>
</span><span><span class="hljs-selector-class">.site-footer</span></span><span> {
  </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-number">#f9f9f9</span></span><span>;
  </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">2rem</span></span><span> </span><span><span class="hljs-number">0</span></span><span>;
  </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">4rem</span></span><span>;
}
</span><span><span class="hljs-selector-class">.footer-inner</span></span><span> {
  </span><span><span class="hljs-attribute">display</span></span><span>: flex;
  </span><span><span class="hljs-attribute">justify-content</span></span><span>: space-between;
  </span><span><span class="hljs-attribute">flex-wrap</span></span><span>: wrap;
}
</span><span><span class="hljs-selector-class">.footer-nav</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span> { </span><span><span class="hljs-attribute">margin-left</span></span><span>: </span><span><span class="hljs-number">1rem</span></span><span>; }

</span><span><span class="hljs-comment">/* Responsive tweaks */</span></span><span>
</span><span><span class="hljs-keyword">@media</span></span><span> (</span><span><span class="hljs-attribute">max-width</span></span><span>: </span><span><span class="hljs-number">768px</span></span><span>) {
  </span><span><span class="hljs-selector-class">.about-section</span></span><span> { </span><span><span class="hljs-attribute">flex-direction</span></span><span>: column; }
  </span><span><span class="hljs-selector-class">.header-inner</span></span><span> { </span><span><span class="hljs-attribute">flex-direction</span></span><span>: column; }
  </span><span><span class="hljs-selector-class">.main-nav</span></span><span> { </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">1rem</span></span><span>; }
}
</span></span></code></div></div></pre>
<hr data-start="11737" data-end="11740">
<h2 data-start="11742" data-end="11768">🚀 Deploying to Netlify</h2>
<ol data-start="11770" data-end="12391">
